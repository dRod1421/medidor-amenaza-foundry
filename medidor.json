Hooks.once('init', () => {
    console.log("Medidor de Amenaza | Inicializando para V13...");
});

Hooks.once('ready', () => {
    // Usamos el nuevo sistema de Application V2 si fuera necesario, 
    // pero para un HUD simple, esta estructura es la más estable en V13:
    class MedidorAmenaza extends Application {
        constructor() {
            super();
            this.g = 2; this.y = 2; this.r = 2;
            this.currentPos = 0;
        }

        static get defaultOptions() {
            return foundry.utils.mergeObject(super.defaultOptions, {
                title: "Medidor de Amenaza",
                id: "medidor-amenaza-hud",
                template: null,
                width: 300,
                height: "auto",
                minimizable: true,
                popOut: true // Asegura que se abra en ventana propia
            });
        }

        activateListeners(html) {
            // En V13, aunque el soporte jQuery se mantiene, 
            // usamos la sintaxis estándar para evitar avisos
            html.querySelector("#avanzar")?.addEventListener("click", () => {
                if(this.currentPos < (this.g + this.y + this.r - 1)) {
                    this.currentPos++;
                    this.render(true);
                }
            });
            html.querySelector("#reset")?.addEventListener("click", () => {
                this.currentPos = 0;
                this.render(true);
            });
        }

        _renderHTML() {
            const total = this.g + this.y + this.r;
            let visual = "";
            for(let i=0; i<total; i++) {
                let icon = (i < this.g) ? "🟢" : (i < this.g + this.y) ? "🟡" : "🔴";
                visual += (i === this.currentPos) ? `<b>${icon}</b>` : `<span style="opacity:0.3">${icon}</span>`;
            }
            
            // Retornamos el string HTML que Foundry renderizará
            return `
                <div style="text-align: center; padding: 10px; background: #000; color: #fff;">
                    <div style="font-size: 2rem; margin-bottom: 10px;">${visual}</div>
                    <button id="avanzar" style="width: 100%; cursor: pointer;">AVANZAR (Giro de Guion)</button>
                    <button id="reset" style="width: 100%; margin-top: 5px; cursor: pointer;">RESET</button>
                </div>
            `;
        }
    }

    const medidor = new MedidorAmenaza();
    medidor.render(true);
});